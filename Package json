import { FormEvent, useCallback, useEffect, useMemo, useState } from 'react';
import {
  Activity,
  ArrowRight,
  Award,
  CalendarDays,
  Check,
  ChevronRight,
  Clock3,
  GraduationCap,
  LogOut,
  Mail,
  MapPin,
  Menu,
  ShieldCheck,
  Stethoscope,
  Users,
  X,
} from 'lucide-react';
import { Session } from '@supabase/Bolt Database-js';
import { Bolt Database } from '@/lib/supabase';

type Profile = {
  id: string;
  full_name: string;
  email: string;
  phone: string | null;
  specialty: string | null;
  city: string | null;
  role: 'member' | 'admin';
  status: 'pending' | 'approved' | 'rejected' | 'suspended';
};

type Event = {
  id: string;
  title: string;
  description: string;
  location: string;
  starts_at: string;
  ends_at: string | null;
  capacity: number | null;
  is_published: boolean;
};

type Training = Event & {
  instructor: string;
};

type Registration = {
  id: string;
  event_id: string;
  member_id: string;
  status: string;
  events?: {
    title: string;
    starts_at: string;
  };
};

type Certificate = {
  id: string;
  title: string;
  issuer: string;
  certificate_number: string;
  issued_at: string;
};

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('fr-FR', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(new Date(value));

const friendlyError = () =>
  'Une erreur est survenue. Vérifiez vos informations puis réessayez.';

function App() {
  const [session, setSession] = useState<Session | null>(null);
  const [profile, setProfile] = useState<Profile | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => setSession(data.session));

    const {
      data: { subscription },
    } = supabase.auth.onAuthStateChange((_event, nextSession) => {
      setSession(nextSession);

      if (!nextSession) {
        setProfile(null);
      }
    });

    return () => subscription.unsubscribe();
  }, []);

  useEffect(() => {
    if (!session?.user.id) {
      setLoading(false);
      return;
    }

    (async () => {
      const { data } = await Bolt Database
        .from('profiles')
        .select('*')
        .eq('id', session.user.id)
        .maybeSingle();

      setProfile(data as Profile | null);
      setLoading(false);
    })();
  }, [session]);

  if (loading) {
    return (
      <div className="splash">
        <div className="brand-mark">
          <Stethoscope size={30} />
        </div>
        <span>ACMM</span>
      </div>
    );
  }

  if (!session) {
    return <AuthScreen />;
  }

  if (!profile) {
    return (
      <div className="center-page">
        <p>Votre profil est en cours de préparation.</p>
        <button
          className="button secondary"
          onClick={() => supabase.auth.signOut()}
        >
          Se déconnecter
        </button>
      </div>
    );
  }

  return profile.role === 'admin' && profile.status === 'approved' ? (
    <AdminApp profile={profile} />
  ) : (
    <MemberApp profile={profile} />
  );
}

function AuthScreen() {
  const [mode, setMode] = useState<'login' | 'signup' | 'reset'>('login');
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState('');
  const [error, setError] = useState('');
  const [form, setForm] = useState({
    name: '',
    email: '',
    password: '',
  });

  const submit = async (event: FormEvent) => {
    event.preventDefault();
    setBusy(true);
    setError('');
    setMessage('');

    const result =
      mode === 'login'
        ? await supabase.auth.signInWithPassword({
            email: form.email,
            password: form.password,
          })
        : mode === 'signup'
          ? await supabase.auth.signUp({
              email: form.email,
              password: form.password,
              options: {
                data: {
                  full_name: form.name,
                },
              },
            })
          : await supabase.auth.resetPasswordForEmail(form.email);

    if (result.error) {
      setError(friendlyError());
    } else if (mode === 'signup') {
      setMessage(
        'Votre demande est enregistrée. Vous pourrez accéder à votre espace après validation par l’administration.',
      );
    } else if (mode === 'reset') {
      setMessage(
        'Si cette adresse est enregistrée, vous recevrez un lien de réinitialisation.',
      );
    }

    setBusy(false);
  };

  return (
    <main className="auth-layout">
      <section className="auth-visual">
        <img
          className="watermark-logo"
          src="/1792262322165 copy 2.jpg"
          alt=""
          aria-hidden="true"
        />

        <div className="visual-content">
          <div className="brand-lockup">
            <div className="brand-mark">
              <Stethoscope size={34} />
            </div>
            <span>ACMM</span>
          </div>

          <p className="arabic">
            الجمعية الولائية للسلك الطبي - سيدي بلعباس
          </p>

          <div className="visual-line" />

          <p className="slogan">Se former, partager, progresser</p>

          <div className="visual-note">
            <Activity size={18} />
            La communauté médicale de Sidi Bel Abbès
          </div>
        </div>
      </section>

      <section className="auth-panel">
        <div className="auth-box">
          <div className="mobile-brand">
            <div className="brand-mark">
              <Stethoscope size={25} />
            </div>
            <strong>ACMM</strong>
          </div>

          <p className="eyebrow">ESPACE MEMBRES</p>

          <h1>
            {mode === 'login'
              ? 'Bienvenue à l’ACMM'
              : mode === 'signup'
                ? 'Rejoindre l’association'
                : 'Réinitialiser le mot de passe'}
          </h1>

          <p className="muted">
            {mode === 'login'
              ? 'Accédez à votre espace professionnel.'
              : mode === 'signup'
                ? 'Créez votre compte membre en quelques instants.'
                : 'Recevez un lien sécurisé par email.'}
          </p>

          <form onSubmit={submit} className="auth-form">
            {mode === 'signup' && (
              <label>
                Nom complet
                <input
                  required
                  value={form.name}
                  onChange={(event) =>
                    setForm({
                      ...form,
                      name: event.target.value,
                    })
                  }
                  placeholder="Dr. Prénom Nom"
                />
              </label>
            )}

            <label>
              Adresse email
              <div className="input-icon">
                <Mail size={17} />
                <input
                  required
                  type="email"
                  value={form.email}
                  onChange={(event) =>
                    setForm({
                      ...form,
                      email: event.target.value,
                    })
                  }
                  placeholder="vous@exemple.com"
                />
              </div>
            </label>

            {mode !== 'reset' && (
              <label>
                Mot de passe
                <input
                  required
                  minLength={6}
                  type="password"
                  value={form.password}
                  onChange={(event) =>
                    setForm({
                      ...form,
                      password: event.target.value,
                    })
                  }
                  placeholder="6 caractères minimum"
                />
              </label>
            )}

            {error && <div className="alert error">{error}</div>}

            {message && <div className="alert success">{message}</div>}

            <button className="button primary full" disabled={busy}>
              {busy
                ? 'Veuillez patienter…'
                : mode === 'login'
                  ? 'Se connecter'
                  : mode === 'signup'
                    ? 'Créer mon compte'
                    : 'Envoyer le lien'}
              <ArrowRight size={18} />
            </button>
          </form>

          <div className="auth-links">
            {mode === 'login' && (
              <>
                <button onClick={() => setMode('reset')}>
                  Mot de passe oublié ?
                </button>

                <span>
                  Pas encore membre ?{' '}
                  <button onClick={() => setMode('signup')}>
                    Créer un compte
                  </button>
                </span>
              </>
            )}

            {mode !== 'login' && (
              <button onClick={() => setMode('login')}>
                Retour à la connexion
              </button>
            )}
          </div>
        </div>
      </section>
    </main>
  );
}

